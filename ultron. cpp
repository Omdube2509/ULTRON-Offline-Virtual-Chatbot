/*=========================================================
              LOGIN FUNCTION
=========================================================*/

int login(TeamMember members[], int size, string &loggedName)
{
    string username;
    string password;

    cout << "\n";
    cout << "==================================================" << endl;
    cout << "             ULTRON AUTHENTICATION" << endl;
    cout << "==================================================" << endl;

    cout << "Username : ";
    getline(cin, username);

    cout << "Password : ";
    getline(cin, password);


    for (int i = 0; i < size; i++)
    {
        if (members[i].getUsername() == username &&
            members[i].getPassword() == password)
        {
            loggedName = members[i].getName();

            cout << "\n==================================================" << endl;
            cout << "          AUTHENTICATION SUCCESSFUL" << endl;
            cout << "==================================================" << endl;

            cout << "Welcome, " << loggedName << "!" << endl;

            return i;
        }
    }


    cout << "\n==================================================" << endl;
    cout << "           AUTHENTICATION FAILED" << endl;
    cout << "==================================================" << endl;

    cout << "Invalid username or password." << endl;

    return -1;
}


/*=========================================================
            FUNCTION OVERLOADING FOR SEARCH
=========================================================*/

// Search by username
int searchMember(TeamMember members[], int size, string username)
{
    for (int i = 0; i < size; i++)
    {
        if (members[i].getUsername() == username)
        {
            return i;
        }
    }

    return -1;
}


// Search by index / ID
int searchMember(TeamMember members[], int size, int index)
{
    if (index >= 0 && index < size)
    {
        return index;
    }

    return -1;
}


