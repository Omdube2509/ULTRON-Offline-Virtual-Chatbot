/*=========================================================
              CLASS 1 : USER
=========================================================*/

class User
{
protected:
    string username;
    string password;
    string name;

public:

    // Default Constructor
    User()
    {
        username = "";
        password = "";
        name = "";
    }

    // Parameterized Constructor
    User(string u, string p, string n)
    {
        username = u;
        password = p;
        name = n;
    }

    // Virtual Function
    virtual void displayRole()
    {
        cout << "Role : User" << endl;
    }

    // Getter functions
    string getUsername()
    {
        return username;
    }

    string getPassword()
    {
        return password;
    }

    string getName()
    {
        return name;
    }

    // Destructor
    virtual ~User()
    {
    }
};


/*=========================================================
          CLASS 2 : TEAM MEMBER
          INHERITANCE FROM USER
=========================================================*/

class TeamMember : public User
{
private:
    int memberID;

public:

    // Default Constructor
    TeamMember() : User()
    {
        memberID = 0;
    }

    // Parameterized Constructor
    TeamMember(string u, string p, string n, int id)
        : User(u, p, n)
    {
        memberID = id;
    }

    // Function Overriding / Runtime Polymorphism
    void displayRole() override
    {
        cout << "Role : ULTRON Team Member" << endl;
    }

    void displayProfile()
    {
        cout << "\n-------------------------------------" << endl;
        cout << "         USER PROFILE" << endl;
        cout << "-------------------------------------" << endl;
        cout << "Member ID : " << memberID << endl;
        cout << "Name      : " << name << endl;
        cout << "Username  : " << username << endl;

        displayRole();

        cout << "-------------------------------------" << endl;
    }
};


