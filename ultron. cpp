    /*-----------------------------------------------------
                  STATIC MEMBER FUNCTION
    -----------------------------------------------------*/

    static void showTotalSessions()
    {
        cout << "\nULTRON : Total sessions initialized = "
             << totalSessions << endl;
    }


    /*-----------------------------------------------------
                  CHAT FUNCTION
    -----------------------------------------------------*/

    void chat()
    {
        int queryNumber = 0;

        displayWelcome();

        while (true)
        {
            cout << "\n--------------------------------------------------" << endl;

            if (credits <= 0)
            {
                cout << "ULTRON : Credit limit reached." << endl;
                cout << "ULTRON : Session terminated." << endl;
                break;
            }

            cout << "Credits Remaining : " << credits << endl;
            cout << "You : ";

            getline(cin, prompt);


            /*---------------------------------------------
                    EXIT DOES NOT USE CREDIT
            ---------------------------------------------*/

            if (prompt == "exit")
            {
                cout << "\nULTRON : Session terminated." << endl;
                cout << "ULTRON : Goodbye, Human!" << endl;
                break;
            }


            /*---------------------------------------------
                         HELP COMMAND
            ---------------------------------------------*/

            if (prompt == "help")
            {
                showHelp();
                continue;
            }


            /*---------------------------------------------
                       CREDIT COMMAND
            ---------------------------------------------*/

            if (prompt == "credits")
            {
                showCredits();
                continue;
            }


            /*---------------------------------------------
                       PROFILE COMMAND
            ---------------------------------------------*/

            if (prompt == "profile")
            {
                displayUser(currentUser);
                continue;
            }


            /*---------------------------------------------
                       SESSION COMMAND
            ---------------------------------------------*/

            if (prompt == "sessions")
            {
                showTotalSessions();
                continue;
            }


            /*---------------------------------------------
                       NORMAL QUERY
            ---------------------------------------------*/

            queryNumber++;

            useCredit();

            processQuery(prompt, queryNumber);


            if (credits == 0)
            {
                cout << "\n==================================================" << endl;
                cout << "             CREDIT LIMIT REACHED" << endl;
                cout << "==================================================" << endl;
                cout << "ULTRON : You have used all available credits." << endl;
                cout << "ULTRON : Session terminated." << endl;
                break;
            }
        }
    }


